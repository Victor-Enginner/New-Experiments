{
  "name": "data-sales-agent",
  "version": "1.0.0",
  "description": "Sistema automatizado Data-to-Sales: coleta dados, gera conteúdo, cria landing page e dashboard de vendas",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "dev": "node --watch main.js",
    "scrape": "node modules/dataCollector.js",
    "generate": "node modules/contentGenerator.js",
    "build": "node modules/landingBuilder.js",
    "pipeline": "node main.js --full-pipeline",
    "serve": "node serve-local.js",
    "local": "node main.js --full-pipeline && node serve-local.js"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "fs-extra": "^11.2.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "jsdom": "^24.0.0"
  }
}